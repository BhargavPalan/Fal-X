# Scan output and caches. Never commit: these contain real target data and
# secret-shaped matches. .gitignore is not a security boundary.
output/
bin/

# Local credentials. Only .env.example belongs in the repository.
config/.env
config/*.local

# Local scope and authorization files. Only the .example templates are published.
config/scope.txt
config/out-of-scope.txt

# Generated by install.sh; records the tool versions of one machine.
tools.lock

# Run artifacts that can leak outside the output tree.
*.log
*.sarif
*.json.tmp

# Release archives.
dist/
fal-x_*
fal-x-*.tar.gz

# Wordlists are fetched by install.sh from the sources recorded in
# wordlists/README.md. Tracking them would add megabytes of downloaded data to
# the history for no benefit, since a clone can regenerate them.
wordlists/*.txt
!wordlists/README.md

# Compiled test binaries left behind by `go test -c` and race builds.
*.test
*.test.exe

# Editor, OS and local scratch.
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
*.code-workspace
tmp/
.cache/
